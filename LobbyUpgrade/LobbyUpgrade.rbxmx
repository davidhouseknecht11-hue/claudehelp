<roblox xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4"><Item class="Script" referent="RBX_LobbyUpgrade"><Properties><string name="Name">LobbyUpgrade</string><bool name="Disabled">false</bool><token name="RunContext">0</token><ProtectedString name="Source"><![CDATA[-- LobbyUpgrade  (Script)
-- Put in: ServerScriptService   (keep its children: KitLoader, KitAnimator, DisasterFX, ShopUI, ShopItems)
--
-- An ADD-ON. It does not replace any of your scripts:
--   * LobbyService still builds the lobby and runs all the lobby rules. This script waits for it,
--     then dresses the lobby up with the Blender kit and adds new things to do.
--   * DisasterGameManager still runs every disaster. This script listens to the same
--     ServerStorage.RoundEvents signal and adds sirens + a storm vortex over the island.
--   * DisasterFX (each player's screen): red title intro, extreme wind, weather, VFX and new
--     Blender looks for the hazards. The new tornado funnel goes in ServerStorage > TornadoAssets.
--   * ShopUI (each player's screen): the new card-style shop; ShopItems lists what it sells.
-- Delete this script and everything goes back to how it was.
--
-- Needs the Blender models: File > Import 3D > LobbyKit.glb (the model can stay in Workspace or
-- be moved to ServerStorage). Without the kit only the non-model extras appear.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Kit = require(script:WaitForChild("KitLoader"))

--------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------
local BONUS_CHEST_COINS = 20      -- coins for reaching the parkour chest (once per round per player)
local JUMP_PAD_POWER = 95         -- launch speed of the jump pads
local SIREN_COUNT = 4             -- sirens that rise on the island when a disaster starts
local VORTEX_HEIGHT = 95          -- studs above the island's highest ground
local ENABLE_DISASTER_ATMOSPHERE = true

local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local WHITE = Color3.new(1, 1, 1)
local CYAN = Color3.fromRGB(60, 230, 255)
local GOLD = Color3.fromRGB(255, 205, 70)

--------------------------------------------------------------------
-- Shared bits
--------------------------------------------------------------------
local hasKit = Kit.load()
if hasKit then
	print("[LobbyUpgrade] Blender kit loaded")
else
	warn("[LobbyUpgrade] LobbyKit not found - import LobbyKit.glb (File > Import 3D). Running without the models.")
end

-- Blender props the client scripts clone: shop icons, disaster effect pieces, new hazard looks
local CLIENT_PROPS = {
	"EggCommon", "EggRare", "EggMythic", "CoinsS", "CoinsM", "CoinsL", "CoinsXL",
	"Shield", "ReviveHeart", "Clover", "CoinX2", "Crown", "GiftBox", "TrailSwirl",
	"FxPlank", "FxRock", "FxMeteorChunk", "FxLeaf", "FxIceShard", "FxBolt", "FxShockRing", "FxWindStreak", "FxDroplet", "FxCloudPuff",
	"MeteorRock", "IceCrystal", "AcidBlob", "LavaBlob", "LavaPool", "QuakeSpike", "Shark", "TsunamiCurl",
	"Moon", "OxygenTank", "Sun", "Mercury", "Venus", "Earth", "Mars", "Jupiter", "Saturn", "Uranus", "Neptune",
}
local propsFolder = ReplicatedStorage:FindFirstChild("LobbyKitProps")
if not propsFolder then
	propsFolder = Instance.new("Folder")
	propsFolder.Name = "LobbyKitProps"
	propsFolder.Parent = ReplicatedStorage
end
if hasKit then
	Kit.publish(CLIENT_PROPS, propsFolder)
	-- New tornado funnel: TornadoDisaster already uses ServerStorage > TornadoAssets > Tornado when it exists
	-- (pieces named layer* spin). A tornado model you put there yourself is kept.
	local tornadoAssets = ServerStorage:FindFirstChild("TornadoAssets")
	if not tornadoAssets then
		tornadoAssets = Instance.new("Folder")
		tornadoAssets.Name = "TornadoAssets"
		tornadoAssets.Parent = ServerStorage
	end
	if not tornadoAssets:FindFirstChild("Tornado") then
		Kit.spawn("Tornado", CFrame.new(), { parent = tornadoAssets, shadows = false })
	end
end

-- client scripts + the shop list run on each player's device
-- Moon Collision (Transcendent): runs through DisasterGameManager's ExtraDisasters hook
do
	local moonModule = script:FindFirstChild("MoonCollision")
	if moonModule and hasKit then
		require(moonModule).init(Kit)
	elseif moonModule then
		warn("[LobbyUpgrade] Moon Collision needs the Blender kit (LobbyKit.glb) - disaster not registered")
	end
end

for _, name in ipairs({ "KitAnimator", "DisasterFX", "ShopUI", "ShopItems", "MoonFX" }) do
	local child = script:FindFirstChild(name)
	if child then
		child.Parent = ReplicatedStorage
	end
end

-- new Robux coin packs: added to ProgressionConfig.Products so ProgressionServer's existing
-- purchase code (ProcessReceipt, Kind = "Coins") pays them out
do
	local itemsModule = ReplicatedStorage:FindFirstChild("ShopItems")
	local configModule = ReplicatedStorage:FindFirstChild("ProgressionConfig")
	if itemsModule and configModule then
		local ok, err = pcall(function()
			require(itemsModule).AddProducts(require(configModule))
		end)
		if not ok then
			warn("[LobbyUpgrade] Could not add the new shop products: " .. tostring(err))
		end
	end
end

local function findOrCreateBindable(name)
	local b = ServerStorage:FindFirstChild(name)
	if not b then
		b = Instance.new("BindableEvent")
		b.Name = name
		b.Parent = ServerStorage
	end
	return b
end
local roundEvents = findOrCreateBindable("RoundEvents")
local awardEvent = findOrCreateBindable("AwardCoins")

local DisasterConfig
do
	local assets = ReplicatedStorage:WaitForChild("DisasterAssets", 10)
	local mod = assets and assets:FindFirstChild("DisasterConfig")
	if mod then
		local ok, result = pcall(require, mod)
		if ok then
			DisasterConfig = result
		end
	end
end

local function mk(class, props, parent)
	local inst = Instance.new(class)
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function ghost(parent, name, size, cf)
	-- invisible, non-solid helper part
	return mk("Part", {
		Name = name,
		Size = size,
		CFrame = cf,
		Anchored = true,
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	}, parent)
end

local function ns(...)
	local args = { ... }
	local points = {}
	for i = 1, #args, 2 do
		table.insert(points, NumberSequenceKeypoint.new(args[i], args[i + 1]))
	end
	return NumberSequence.new(points)
end

local function sparkleBurst(parent, position, color, count, speed)
	local p = ghost(parent, "Burst", Vector3.new(1, 1, 1), CFrame.new(position))
	local e = mk("ParticleEmitter", {
		Texture = TEX_SPARK,
		Color = ColorSequence.new(color, WHITE),
		Size = ns(0, 0.4, 0.2, 2.6, 1, 0),
		Transparency = ns(0, 0, 0.7, 0.2, 1, 1),
		Lifetime = NumberRange.new(1, 2),
		Speed = NumberRange.new(speed * 0.5, speed),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -18, 0),
		Drag = 1.5,
		LightEmission = 1,
		LightInfluence = 0,
		Rate = 0,
		Enabled = false,
	}, p)
	e:Emit(count)
	local light = mk("PointLight", { Color = color, Range = 40, Brightness = 6 }, p)
	TweenService:Create(light, TweenInfo.new(0.8), { Brightness = 0 }):Play()
	Debris:AddItem(p, 3)
end

local function billboard(parent, adornee, sizeStuds, text, color)
	local gui = mk("BillboardGui", {
		Size = UDim2.fromScale(sizeStuds.X, sizeStuds.Y),
		Adornee = adornee,
		AlwaysOnTop = false,
		MaxDistance = 350,
		LightInfluence = 0,
	}, parent)
	local label = mk("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = text,
		TextColor3 = color,
		TextScaled = true,
		RichText = false,
	}, gui)
	mk("UIStroke", { Color = Color3.fromRGB(10, 12, 24), Thickness = 3 }, label)
	return gui, label
end

--------------------------------------------------------------------
-- LOBBY
--------------------------------------------------------------------
local setBanner = nil      -- set once the lobby banner exists
local chestClaimed = {}    -- [Player] = true (reset every round)

local function featuredText()
	if DisasterConfig and DisasterConfig.GetFeaturedId then
		local ok, id = pcall(DisasterConfig.GetFeaturedId)
		local d = ok and DisasterConfig.GetDisasterById(id)
		if d then
			local mult = DisasterConfig.Event and DisasterConfig.Event.WeightMultiplier or 3
			local bonus = DisasterConfig.Event and DisasterConfig.Event.CoinBonus or 0.5
			return ("⭐ FEATURED THIS WEEK ⭐\n%s %s  •  %dx chance  •  +%d%% coins"):format(d.Emoji, string.upper(d.Name), mult, math.floor(bonus * 100 + 0.5)), d.Color
		end
	end
	return "⭐ SURVIVE THE DISASTERS ⭐\nCollect coins while you wait", GOLD
end

local function upgradeLobby()
	local lobby = workspace:WaitForChild("Lobby", 60)
	if not lobby then
		warn("[LobbyUpgrade] workspace.Lobby never appeared (is LobbyService running?) - lobby upgrade skipped")
		return
	end
	local origin = lobby:GetAttribute("Origin")
	local waited = 0
	while typeof(origin) ~= "Vector3" and waited < 10 do
		waited += task.wait(0.2)
		origin = lobby:GetAttribute("Origin")
	end
	if typeof(origin) ~= "Vector3" then
		warn("[LobbyUpgrade] Lobby has no Origin attribute - lobby upgrade skipped")
		return
	end
	lobby:WaitForChild("LobbyCoin", 10)
	task.wait(0.5) -- let LobbyService finish building

	local floorY = origin.Y + 1 -- top of the lobby floor
	local deco = mk("Folder", { Name = "LobbyUpgrade" }, workspace)

	local function P(x, y, z)
		return Vector3.new(origin.X + x, floorY + y, origin.Z + z)
	end
	local function facing(pos) -- stands at pos, looks at the middle of the lobby
		return CFrame.lookAt(pos, Vector3.new(origin.X, pos.Y, origin.Z))
	end
	local function spawn(name, cf, opts)
		opts = opts or {}
		opts.parent = deco
		return Kit.spawn(name, cf, opts)
	end

	-- 1) New deck: floating sky island with glowing rings, fence and crystals underneath.
	--    The old floor and rails stay as (invisible) collision.
	if spawn("Hub", CFrame.new(P(0, 0.05, 0))) then
		for _, c in ipairs(lobby:GetChildren()) do
			if c:IsA("BasePart") and (c.Name == "Floor" or c.Name == "Rail") then
				c.Transparency = 1
			end
		end
	end

	-- 2) Kiosks become real little buildings (the old blocks keep their prompts, just hidden)
	for oldName, propName in pairs({
		ShopKiosk = "KioskShop",
		QuestKiosk = "KioskQuests",
		DailyKiosk = "KioskDaily",
		BoardKiosk = "KioskBoard",
	}) do
		local base = lobby:FindFirstChild(oldName)
		if base and base:IsA("BasePart") then
			local pos = Vector3.new(base.Position.X, floorY, base.Position.Z)
			if spawn(propName, facing(pos)) then
				base.Transparency = 1
				local top = lobby:FindFirstChild(oldName .. "Top")
				if top and top:IsA("BasePart") then
					top.Transparency = 1
				end
				local bb = base:FindFirstChildOfClass("BillboardGui")
				if bb then
					bb.StudsOffset = Vector3.new(0, 18, 0)
					bb.Size = UDim2.fromOffset(240, 64)
					bb.MaxDistance = 220
				end
			end
			mk("PointLight", { Color = base.Color, Range = 26, Brightness = 1.4 }, base)
		end
	end

	-- 3) Frames + lights around the three wall signs
	for _, signName in ipairs({ "WelcomeSign", "StatusBoard", "LeaderboardSign" }) do
		local sign = lobby:FindFirstChild(signName)
		if sign and sign:IsA("BasePart") then
			spawn("SignFrame", facing(Vector3.new(sign.Position.X, floorY, sign.Position.Z)))
			mk("SurfaceLight", { Face = Enum.NormalId.Front, Color = CYAN, Range = 18, Brightness = 1.2, Angle = 120 }, sign)
		end
	end

	-- 4) Crystal lamp pillars around the edge
	for _, xz in ipairs({ { 54, 54 }, { -54, 54 }, { 54, -54 }, { -54, -54 }, { 54, 34 }, { -54, 34 }, { 54, -34 }, { -54, -34 }, { 34, -54 }, { -34, -54 } }) do
		local pillar = spawn("Pillar", CFrame.new(P(xz[1], 0, xz[2])), { motion = nil })
		local crystal = pillar and pillar:FindFirstChild("crystal")
		if crystal then
			mk("PointLight", { Color = CYAN, Range = 26, Brightness = 1.3 }, crystal)
		end
	end

	-- 5) Centrepiece: floating mini island with a spinning tornado, orbit rings and a meteor,
	--    a light beam you can see from the island, and a banner with the featured disaster.
	spawn("Holo", CFrame.new(P(0, 10, 0)))
	mk("Part", {
		Name = "SkyBeam",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(420, 4, 4),
		CFrame = CFrame.new(P(0, 48 + 210, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = CYAN,
		Material = Enum.Material.Neon,
		Transparency = 0.6,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	}, deco)

	local bannerPart = ghost(deco, "FeaturedBanner", Vector3.new(1, 1, 1), CFrame.new(P(0, 56, 0)))
	local _, bannerLabel = billboard(bannerPart, bannerPart, Vector2.new(54, 11), "", GOLD)
	local function showFeatured()
		local text, color = featuredText()
		bannerLabel.Text = text
		bannerLabel.TextColor3 = color:Lerp(WHITE, 0.25)
	end
	showFeatured()
	setBanner = function(disasterId)
		local d = disasterId and DisasterConfig and DisasterConfig.GetDisasterById(disasterId)
		if d then
			bannerLabel.Text = ("🔴 HAPPENING NOW 🔴\n%s %s"):format(d.Emoji, string.upper(d.Name))
			bannerLabel.TextColor3 = d.Color:Lerp(WHITE, 0.25)
		else
			showFeatured()
		end
	end

	-- gentle sparkles drifting up from the whole deck
	local sparkPart = ghost(deco, "DeckSparkles", Vector3.new(110, 1, 110), CFrame.new(P(0, 0.5, 0)))
	mk("ParticleEmitter", {
		Texture = TEX_SPARK,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, CYAN),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 210)),
			ColorSequenceKeypoint.new(1, GOLD),
		}),
		Size = ns(0, 0, 0.3, 0.9, 1, 0),
		Transparency = ns(0, 0.2, 1, 1),
		Lifetime = NumberRange.new(3, 6),
		Rate = 14,
		Speed = NumberRange.new(1.5, 4),
		SpreadAngle = Vector2.new(15, 15),
		EmissionDirection = Enum.NormalId.Top,
		LightEmission = 1,
		LightInfluence = 0,
		RotSpeed = NumberRange.new(-60, 60),
	}, sparkPart)

	-- 6) Scenery: bobbing islands and two hot-air balloons circling the lobby
	for i, v in ipairs({ { 105, 6, -70, 1.6 }, { -110, -8, -40, 2.1 }, { -95, 16, 80, 1.3 }, { 100, -4, 75, 1.8 }, { 20, 20, -120, 1.5 }, { -30, -12, 118, 1.2 } }) do
		spawn("FloatIsland", CFrame.new(P(v[1], v[2], v[3])) * CFrame.Angles(0, i * 1.3, 0), {
			scale = v[4],
			motion = { kind = "bob", amp = 2.5, speed = 0.45, phase = i * 1.1 },
		})
	end
	spawn("Balloon", CFrame.new(P(96, 46, 0)), {
		motion = { kind = "orbit", center = P(0, 46, 0), radius = 96, speed = 5, amp = 3, phase = 0 },
	})
	local blue = spawn("Balloon", CFrame.new(P(-122, 62, 0)), {
		scale = 1.25,
		motion = { kind = "orbit", center = P(0, 62, 0), radius = 122, speed = -3.5, amp = 4, phase = 3.1 },
	})
	if blue and blue:FindFirstChild("envelope") then
		blue.envelope.Color = Color3.fromRGB(70, 130, 255)
	end

	-- 7) Parkour: stepping stones up to a floating island with a bonus chest
	local useKitSteps = Kit.has("Step")
	local steps = { { 31, 3.5, -5 }, { 23, 7.5, -8 }, { 16, 11.5, -13 }, { 14, 15.5, -22 }, { 19, 19.5, -30 }, { 26, 23.5, -37 } }
	for i, s in ipairs(steps) do
		local top = P(s[1], s[2], s[3])
		spawn("Step", CFrame.new(top) * CFrame.Angles(0, i * 0.5, 0), { motion = nil })
		mk("Part", {
			Name = "StepCollision",
			Size = Vector3.new(6, 1, 6),
			CFrame = CFrame.new(top - Vector3.new(0, 0.5, 0)),
			Anchored = true,
			Transparency = useKitSteps and 1 or 0,
			Color = CYAN,
			Material = Enum.Material.Neon,
			CastShadow = false,
		}, deco)
	end
	local startLabel = ghost(deco, "ParkourLabel", Vector3.new(1, 1, 1), CFrame.new(P(31, 9, -5)))
	billboard(startLabel, startLabel, Vector2.new(14, 3), "⬆ PARKOUR → BONUS CHEST", GOLD).MaxDistance = 90

	local islandTop = P(40, 26.5, -40)
	local useKitIsland = spawn("FloatIsland", CFrame.new(islandTop), { scale = 1.5, name = "BonusIsland" }) ~= nil
	mk("Part", {
		Name = "BonusIslandCollision",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 23, 23),
		CFrame = CFrame.new(islandTop - Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Anchored = true,
		Transparency = useKitIsland and 1 or 0,
		Color = Color3.fromRGB(96, 200, 84),
		CastShadow = false,
	}, deco)

	local chestPos = P(41, 26.5, -42)
	local chestModel = spawn("Chest", facing(chestPos), { scale = 1.5 })
	local chestTrigger = mk("Part", {
		Name = "BonusChest",
		Size = Vector3.new(9, 6, 7),
		CFrame = facing(chestPos + Vector3.new(0, 3, 0)),
		Anchored = true,
		Transparency = chestModel and 1 or 0,
		Color = GOLD,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanTouch = true,
		CanQuery = false,
		CastShadow = false,
	}, deco)
	mk("PointLight", { Color = GOLD, Range = 22, Brightness = 2 }, chestTrigger)
	local chestSparks = mk("ParticleEmitter", {
		Texture = TEX_SPARK,
		Color = ColorSequence.new(GOLD, WHITE),
		Size = ns(0, 0, 0.3, 1.2, 1, 0),
		Lifetime = NumberRange.new(1, 2),
		Rate = 6,
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(40, 40),
		EmissionDirection = Enum.NormalId.Top,
		LightEmission = 1,
		LightInfluence = 0,
	}, chestTrigger)
	local chestLabelPart = ghost(deco, "ChestLabel", Vector3.new(1, 1, 1), CFrame.new(chestPos + Vector3.new(0, 10, 0)))
	billboard(chestLabelPart, chestLabelPart, Vector2.new(13, 3.2), ("🎁 BONUS CHEST  +%d 🪙"):format(BONUS_CHEST_COINS), GOLD).MaxDistance = 160

	chestTrigger.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not player or not humanoid or humanoid.Health <= 0 or chestClaimed[player] then
			return
		end
		chestClaimed[player] = true
		awardEvent:Fire(player, BONUS_CHEST_COINS, "lobby_bonus_chest")
		chestSparks:Emit(60)
		sparkleBurst(deco, chestPos + Vector3.new(0, 5, 0), GOLD, 50, 28)
		local popPart = ghost(deco, "ChestPopup", Vector3.new(1, 1, 1), CFrame.new(chestPos + Vector3.new(0, 6, 0)))
		local popGui, popLabel = billboard(popPart, popPart, Vector2.new(12, 3), ("%s  +%d 🪙"):format(player.DisplayName, BONUS_CHEST_COINS), WHITE)
		popGui.AlwaysOnTop = true
		TweenService:Create(popPart, TweenInfo.new(1.6), { CFrame = popPart.CFrame + Vector3.new(0, 7, 0) }):Play()
		TweenService:Create(popLabel, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
		Debris:AddItem(popPart, 1.8)
	end)

	-- 8) Jump pads
	for _, xz in ipairs({ { -34, -34 }, { -34, 28 } }) do
		local pos = P(xz[1], 0, xz[2])
		local model = spawn("JumpPad", CFrame.new(pos))
		local pad = mk("Part", {
			Name = "JumpPad",
			Shape = model and Enum.PartType.Block or Enum.PartType.Cylinder,
			Size = model and Vector3.new(6.5, 2.4, 6.5) or Vector3.new(0.8, 7, 7),
			CFrame = model and CFrame.new(pos + Vector3.new(0, 1.2, 0)) or (CFrame.new(pos + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90))),
			Anchored = true,
			Transparency = model and 1 or 0.1,
			Color = Color3.fromRGB(90, 255, 140),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanTouch = true,
			CanQuery = false,
			CastShadow = false,
		}, deco)
		pad:SetAttribute("Power", JUMP_PAD_POWER)
		mk("PointLight", { Color = pad.Color, Range = 16, Brightness = 1.5 }, pad)
		CollectionService:AddTag(pad, "KitJumpPad")
	end

	-- 9) Star coins: a kit coin rides on every lobby coin (the plain coin is hidden on screen)
	if Kit.has("Coin") then
		for _, coin in ipairs(lobby:GetChildren()) do
			if coin.Name == "LobbyCoin" and coin:IsA("BasePart") then
				spawn("Coin", CFrame.new(coin.Position), { scale = 1.15, motion = { kind = "follow", target = coin } })
			end
		end
	end

	print("[LobbyUpgrade] Lobby upgraded")
end

--------------------------------------------------------------------
-- DISASTER ATMOSPHERE  (sirens + storm vortex + all-clear fireworks)
--------------------------------------------------------------------
local atmo = nil      -- { folder, vortexes = {}, sirens = { {model, upCF, downCF} } }
local atmoToken = 0
local rng = Random.new()

local function islandBounds()
	local island = workspace:FindFirstChild("IslandMap")
	local ground = island and (island:FindFirstChild("Ground") or island)
	local water = island and island:FindFirstChild("Water")
	local lo, hi
	if ground then
		for _, d in ipairs(ground:GetDescendants()) do
			if d:IsA("BasePart") and not (water and water:IsAncestorOf(d)) then
				local a, b = d.Position - d.Size / 2, d.Position + d.Size / 2
				lo = lo and Vector3.new(math.min(lo.X, a.X), math.min(lo.Y, a.Y), math.min(lo.Z, a.Z)) or a
				hi = hi and Vector3.new(math.max(hi.X, b.X), math.max(hi.Y, b.Y), math.max(hi.Z, b.Z)) or b
			end
		end
	end
	if not lo then
		return nil
	end
	return lo, hi, ground
end

-- moves a prop smoothly between two CFrames (server side, a couple of seconds at most)
local function glide(model, fromCF, toCF, seconds, style, direction)
	local elapsed = 0
	while elapsed < seconds and model.Parent do
		elapsed += RunService.Heartbeat:Wait()
		local a = TweenService:GetValue(math.clamp(elapsed / seconds, 0, 1), style, direction)
		model:PivotTo(fromCF:Lerp(toCF, a))
	end
	if model.Parent then
		model:PivotTo(toCF)
	end
end

local function clearAtmosphere(old, instant)
	if not old then
		return
	end
	if instant then
		old.folder:Destroy()
		return
	end
	for _, vortex in ipairs(old.vortexes) do
		Kit.fade(vortex, false, 2.5)
	end
	for _, siren in ipairs(old.sirens) do
		task.spawn(glide, siren.model, siren.upCF, siren.downCF, 1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	Debris:AddItem(old.folder, 3.5)
end

local function startAtmosphere(disasterId)
	atmoToken += 1
	local token = atmoToken
	clearAtmosphere(atmo, true)
	atmo = nil

	local lo, hi, ground = islandBounds()
	if not lo then
		return
	end
	local d = DisasterConfig and disasterId and DisasterConfig.GetDisasterById(disasterId)
	local color = d and d.Color or Color3.fromRGB(255, 70, 70)
	local mythic = d and d.Rarity == "Mythic"
	local center = (lo + hi) / 2
	local span = math.max(hi.X - lo.X, hi.Z - lo.Z)

	local folder = mk("Folder", { Name = "DisasterAtmosphere" }, workspace)
	local state = { folder = folder, vortexes = {}, sirens = {} }
	atmo = state

	-- storm vortex spinning over the island, glowing in the disaster's colour
	local function addVortex(height, scale, tint, yaw)
		local vortex = Kit.spawn("StormRing", CFrame.new(center.X, hi.Y + height, center.Z) * CFrame.Angles(0, yaw, 0), {
			scale = scale,
			tint = tint,
			parent = folder,
			shadows = false,
			noCull = true,
		})
		if vortex then
			Kit.setTransparency(vortex, 1)
			Kit.fade(vortex, true, 3)
			table.insert(state.vortexes, vortex)
		end
		return vortex
	end
	local baseScale = math.clamp(span * 0.6 / 100, 0.8, 3)
	addVortex(VORTEX_HEIGHT, baseScale, color, 0)
	if mythic then
		addVortex(VORTEX_HEIGHT - 28, baseScale * 0.55, color:Lerp(WHITE, 0.5), 1)
	end

	-- lightning flickers inside the cloud
	task.spawn(function()
		while atmoToken == token and folder.Parent do
			task.wait(rng:NextNumber(1.5, 4.5))
			if atmoToken ~= token or not folder.Parent then
				break
			end
			for _, vortex in ipairs(state.vortexes) do
				local arms = vortex:FindFirstChild("arms" .. rng:NextInteger(0, 1))
				if arms then
					local oldColor, oldMaterial = arms.Color, arms.Material
					for _ = 1, 2 do
						arms.Color = color:Lerp(WHITE, 0.7)
						arms.Material = Enum.Material.Neon
						task.wait(0.07)
						arms.Color = oldColor
						arms.Material = oldMaterial
						task.wait(0.06)
					end
				end
			end
		end
	end)

	-- sirens burst out of the ground with spinning beacons
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { ground }
	for i = 1, SIREN_COUNT do
		local angle = (i - 0.5) / SIREN_COUNT * math.pi * 2
		local x = center.X + math.cos(angle) * (hi.X - lo.X) * 0.3
		local z = center.Z + math.sin(angle) * (hi.Z - lo.Z) * 0.3
		local hit = workspace:Raycast(Vector3.new(x, hi.Y + 60, z), Vector3.new(0, -(hi.Y - lo.Y) - 120, 0), params)
		if hit then
			local scale = 1.4
			local upCF = CFrame.new(hit.Position) * CFrame.Angles(0, angle, 0)
			local downCF = upCF - Vector3.new(0, 26 * scale, 0)
			local siren = Kit.spawn("Siren", downCF, { scale = scale, tint = color, parent = folder })
			if siren then
				table.insert(state.sirens, { model = siren, upCF = upCF, downCF = downCF })
				local beacon = siren:FindFirstChild("beacon")
				if beacon then
					mk("PointLight", { Color = color, Range = 30, Brightness = 3 }, beacon)
					for _, face in ipairs({ Enum.NormalId.Right, Enum.NormalId.Left }) do
						mk("SpotLight", { Color = color, Face = face, Range = 60, Angle = 50, Brightness = 8 }, beacon)
					end
				end
				task.delay((i - 1) * 0.25, function()
					if atmoToken ~= token or not siren.Parent then
						return
					end
					local dust = ghost(folder, "SirenDust", Vector3.new(6, 1, 6), CFrame.new(hit.Position))
					mk("ParticleEmitter", {
						Texture = TEX_SMOKE,
						Color = ColorSequence.new(Color3.fromRGB(190, 175, 150)),
						Size = ns(0, 3, 1, 12),
						Transparency = ns(0, 0.4, 1, 1),
						Lifetime = NumberRange.new(1, 2),
						Speed = NumberRange.new(6, 16),
						SpreadAngle = Vector2.new(70, 70),
						EmissionDirection = Enum.NormalId.Top,
						Drag = 2,
						Rate = 0,
						Enabled = false,
					}, dust):Emit(24)
					Debris:AddItem(dust, 3)
					glide(siren, downCF, upCF, 1.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				end)
			end
		end
	end
end

local function endAtmosphere()
	atmoToken += 1
	local old = atmo
	atmo = nil
	if not old then
		return
	end
	clearAtmosphere(old, false)

	-- all clear: fireworks over the island for the survivors
	local lo, hi = islandBounds()
	if not lo then
		return
	end
	local center = (lo + hi) / 2
	local colors = { GOLD, CYAN, Color3.fromRGB(255, 110, 210), Color3.fromRGB(120, 255, 140), Color3.fromRGB(255, 150, 60) }
	for i = 1, 7 do
		task.delay(0.4 + i * 0.3, function()
			local pos = Vector3.new(
				center.X + rng:NextNumber(-0.3, 0.3) * (hi.X - lo.X),
				hi.Y + rng:NextNumber(30, 60),
				center.Z + rng:NextNumber(-0.3, 0.3) * (hi.Z - lo.Z)
			)
			sparkleBurst(workspace, pos, colors[((i - 1) % #colors) + 1], 70, 45)
		end)
	end
end

--------------------------------------------------------------------
-- Wiring
--------------------------------------------------------------------
roundEvents.Event:Connect(function(kind, disasterId)
	if kind == "Started" then
		chestClaimed = {}
		if setBanner then
			setBanner(disasterId)
		end
		if ENABLE_DISASTER_ATMOSPHERE and hasKit then
			local ok, err = pcall(startAtmosphere, disasterId)
			if not ok then
				warn("[LobbyUpgrade] Disaster atmosphere failed: " .. tostring(err))
			end
		end
	elseif kind == "Ended" then
		if setBanner then
			setBanner(nil)
		end
		local ok, err = pcall(endAtmosphere)
		if not ok then
			warn("[LobbyUpgrade] Disaster atmosphere cleanup failed: " .. tostring(err))
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	chestClaimed[player] = nil
end)

task.spawn(function()
	local ok, err = pcall(upgradeLobby)
	if not ok then
		warn("[LobbyUpgrade] Lobby upgrade failed: " .. tostring(err))
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX_KitLoader"><Properties><string name="Name">KitLoader</string><ProtectedString name="Source"><![CDATA[-- KitLoader  (ModuleScript, child of the LobbyUpgrade script)
--
-- Finds the Blender kit ("LobbyKit", imported with File > Import 3D), fixes its scale,
-- and hands out coloured, ready-to-place copies of each prop.
--
-- Mesh names from Blender look like   Prop__piece__colorKey__anim
--   colorKey -> PALETTE below (colour, material, transparency)
--   anim     -> "spin40", "bob0.5", "spin40_bob0.5" ... played on each player's screen by KitAnimator

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local Kit = {}
Kit.Loaded = false

-- generated by blender_lobby_kit.py (keep in sync with PAL in that file)
local PALETTE = {
	stone = { Color3.fromRGB(72, 78, 98), "Slate", 0 },
	stoneLight = { Color3.fromRGB(190, 198, 220), "Concrete", 0 },
	tile = { Color3.fromRGB(52, 92, 190), "SmoothPlastic", 0 },
	tileLight = { Color3.fromRGB(92, 150, 240), "SmoothPlastic", 0 },
	tileDark = { Color3.fromRGB(28, 34, 64), "SmoothPlastic", 0 },
	white = { Color3.fromRGB(245, 246, 250), "SmoothPlastic", 0 },
	black = { Color3.fromRGB(30, 32, 40), "SmoothPlastic", 0 },
	gold = { Color3.fromRGB(255, 196, 58), "SmoothPlastic", 0 },
	wood = { Color3.fromRGB(160, 104, 58), "Wood", 0 },
	woodDark = { Color3.fromRGB(100, 64, 40), "Wood", 0 },
	red = { Color3.fromRGB(230, 64, 64), "SmoothPlastic", 0 },
	green = { Color3.fromRGB(72, 200, 112), "SmoothPlastic", 0 },
	blue = { Color3.fromRGB(70, 130, 255), "SmoothPlastic", 0 },
	purple = { Color3.fromRGB(160, 96, 255), "SmoothPlastic", 0 },
	orange = { Color3.fromRGB(255, 150, 50), "SmoothPlastic", 0 },
	orangeLight = { Color3.fromRGB(255, 186, 96), "SmoothPlastic", 0 },
	yellow = { Color3.fromRGB(255, 214, 40), "SmoothPlastic", 0 },
	grass = { Color3.fromRGB(96, 200, 84), "Grass", 0 },
	leaf = { Color3.fromRGB(58, 168, 84), "Grass", 0 },
	rock = { Color3.fromRGB(118, 106, 102), "Slate", 0 },
	rockDark = { Color3.fromRGB(80, 72, 76), "Slate", 0 },
	metal = { Color3.fromRGB(126, 134, 148), "Metal", 0 },
	cloudDark = { Color3.fromRGB(62, 66, 90), "SmoothPlastic", 0.12 },
	cloudStorm = { Color3.fromRGB(112, 118, 146), "SmoothPlastic", 0.2 },
	cyanGlow = { Color3.fromRGB(60, 230, 255), "Neon", 0 },
	pinkGlow = { Color3.fromRGB(255, 90, 200), "Neon", 0 },
	goldGlow = { Color3.fromRGB(255, 214, 90), "Neon", 0 },
	greenGlow = { Color3.fromRGB(90, 255, 140), "Neon", 0 },
	orangeGlow = { Color3.fromRGB(255, 140, 40), "Neon", 0 },
	cream = { Color3.fromRGB(240, 232, 208), "SmoothPlastic", 0 },
	spot = { Color3.fromRGB(176, 140, 96), "SmoothPlastic", 0 },
	pink = { Color3.fromRGB(255, 120, 190), "SmoothPlastic", 0 },
	ice = { Color3.fromRGB(170, 225, 255), "Ice", 0.15 },
	water = { Color3.fromRGB(80, 170, 255), "Glass", 0.3 },
	windWhite = { Color3.fromRGB(255, 255, 255), "SmoothPlastic", 0.45 },
	dust = { Color3.fromRGB(176, 150, 118), "SmoothPlastic", 0.3 },
	violet = { Color3.fromRGB(130, 105, 175), "SmoothPlastic", 0.3 },
	indigo = { Color3.fromRGB(62, 52, 118), "SmoothPlastic", 0.25 },
	coreGlow = { Color3.fromRGB(255, 236, 205), "Neon", 0.55 },
	fireTrail = { Color3.fromRGB(255, 120, 30), "Neon", 0.35 },
	acidGlow = { Color3.fromRGB(140, 255, 60), "Neon", 0 },
	lavaGlow = { Color3.fromRGB(255, 110, 20), "Neon", 0 },
	waveDeep = { Color3.fromRGB(10, 80, 160), "Glass", 0.15 },
	waveLight = { Color3.fromRGB(110, 225, 255), "Glass", 0.25 },
	foam = { Color3.fromRGB(240, 250, 255), "SmoothPlastic", 0 },
	sharkGrey = { Color3.fromRGB(100, 118, 140), "SmoothPlastic", 0 },
	sharkBelly = { Color3.fromRGB(225, 232, 240), "SmoothPlastic", 0 },
	moonGrey = { Color3.fromRGB(168, 166, 160), "Slate", 0 },
	moonDark = { Color3.fromRGB(98, 96, 94), "Slate", 0 },
	concrete = { Color3.fromRGB(150, 152, 148), "Concrete", 0 },
	concreteDark = { Color3.fromRGB(96, 98, 96), "Concrete", 0 },
	hazard = { Color3.fromRGB(255, 196, 20), "SmoothPlastic", 0 },
	redGlow = { Color3.fromRGB(255, 40, 30), "Neon", 0 },
	o2Green = { Color3.fromRGB(60, 200, 110), "Metal", 0 },
	sunGlow = { Color3.fromRGB(255, 200, 80), "Neon", 0 },
	sunCore = { Color3.fromRGB(255, 245, 200), "Neon", 0 },
	mercury = { Color3.fromRGB(150, 140, 130), "Slate", 0 },
	venus = { Color3.fromRGB(230, 190, 120), "SmoothPlastic", 0 },
	earthBlue = { Color3.fromRGB(40, 110, 220), "SmoothPlastic", 0 },
	earthGreen = { Color3.fromRGB(70, 170, 80), "Grass", 0 },
	cloudWhite = { Color3.fromRGB(245, 248, 255), "SmoothPlastic", 0.2 },
	mars = { Color3.fromRGB(200, 90, 50), "Slate", 0 },
	jupiter1 = { Color3.fromRGB(215, 170, 120), "SmoothPlastic", 0 },
	jupiter2 = { Color3.fromRGB(170, 110, 70), "SmoothPlastic", 0 },
	saturn = { Color3.fromRGB(225, 200, 140), "SmoothPlastic", 0 },
	ring = { Color3.fromRGB(210, 190, 150), "SmoothPlastic", 0.3 },
	uranus = { Color3.fromRGB(150, 220, 230), "SmoothPlastic", 0 },
	neptune = { Color3.fromRGB(60, 90, 220), "SmoothPlastic", 0 },
	tint = { Color3.fromRGB(255, 70, 70), "Neon", 0 },
	x = { Color3.fromRGB(255, 0, 255), "SmoothPlastic", 1 },
}

local props = {} -- [propName] = { pieces = { {part, piece, color, anim} }, anchor = part?, front = part? }

local function parse(name)
	name = string.gsub(name, "_Node$", "") -- Studio's importer adds "_Node" to the wrapper models
	local bits = string.split(name, "__")
	if #bits < 3 then
		return nil
	end
	local color = string.match(bits[3], "^%a+") or bits[3] -- ignore any suffix the importer added
	return bits[1], bits[2], color, bits[4]
end

-- The kit can sit in ServerStorage, ReplicatedStorage or Workspace, under any name.
local function findKitParts()
	for _, where in ipairs({ ServerStorage, ReplicatedStorage, workspace }) do
		for _, d in ipairs(where:GetDescendants()) do
			if d:IsA("BasePart") and string.sub(d.Name, 1, 16) == "ScaleRef__cube__" then
				-- climb to the outermost Model that holds the kit
				-- (Workspace itself counts as a Model, so stop before it)
				local top = d.Parent
				while top.Parent and top.Parent ~= where and top.Parent:IsA("Model") do
					top = top.Parent
				end
				local parts = {}
				for _, p in ipairs(top:GetDescendants()) do
					if p:IsA("BasePart") and parse(p.Name) then
						table.insert(parts, p)
					end
				end
				if top == where then
					-- loose meshes dropped straight into a service: gather them into one model
					top = Instance.new("Model")
					top.Name = "LobbyKit"
					top.Parent = ServerStorage
					for _, p in ipairs(parts) do
						p.Parent = top
					end
				end
				return top, parts, d
			end
		end
	end
	return nil
end

function Kit.load()
	local top, parts, ref = findKitParts()
	if not top then
		return false
	end

	-- freeze everything first (imported meshes are often unanchored)
	for _, p in ipairs(parts) do
		p.Anchored = true
	end

	-- The Blender kit is built 1 unit = 1 stud. Whatever unit the importer used, the 10-stud
	-- reference cube tells us how to get back to that.
	local s = 10 / math.max(ref.Size.X, ref.Size.Y, ref.Size.Z)
	if math.abs(s - 1) > 0.02 then
		local about = ref.Position
		for _, p in ipairs(parts) do
			local cf = p.CFrame
			p.Size = p.Size * s
			p.CFrame = CFrame.new(about + (cf.Position - about) * s) * cf.Rotation
		end
		print(("[LobbyUpgrade] Kit rescaled x%.3f"):format(s))
	end

	-- keep the kit out of the world while the game runs
	if top:IsDescendantOf(workspace) then
		top.Parent = ServerStorage
	end

	for _, p in ipairs(parts) do
		local prop, piece, colorKey, anim = parse(p.Name)
		local def = props[prop]
		if not def then
			def = { pieces = {} }
			props[prop] = def
		end
		if piece == "anchor" then
			def.anchor = p
		elseif piece == "front" then
			def.front = p
		else
			table.insert(def.pieces, { part = p, piece = piece, color = colorKey, anim = anim })
		end
	end

	Kit.Loaded = true
	return true
end

function Kit.has(name)
	return props[name] ~= nil and #props[name].pieces > 0
end

local function style(part, key, opts)
	local e = PALETTE[key] or PALETTE.white
	local color = e[1]
	if key == "tint" and opts.tint then
		color = opts.tint
	end
	part.Color = color
	part.Material = Enum.Material[e[2]]
	part.Transparency = e[3]
	part:SetAttribute("KitT", e[3])
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = opts.shadows ~= false and e[2] ~= "Neon"
	for _, c in ipairs(part:GetChildren()) do
		if c:IsA("SurfaceAppearance") or c:IsA("Decal") or c:IsA("Texture") then
			c:Destroy()
		end
	end
	if part:IsA("MeshPart") then
		pcall(function()
			part.TextureID = ""
		end)
	end
end

-- where the prop's own origin is inside the imported kit
local function propPivot(def)
	local pos
	if def.anchor then
		pos = def.anchor.Position
	else
		-- no anchor mesh survived the import: use the bottom centre of the prop
		local lo, hi
		for _, piece in ipairs(def.pieces) do
			local p = piece.part
			local a, b = p.Position - p.Size / 2, p.Position + p.Size / 2
			lo = lo and Vector3.new(math.min(lo.X, a.X), math.min(lo.Y, a.Y), math.min(lo.Z, a.Z)) or a
			hi = hi and Vector3.new(math.max(hi.X, b.X), math.max(hi.Y, b.Y), math.max(hi.Z, b.Z)) or b
		end
		pos = Vector3.new((lo.X + hi.X) / 2, lo.Y, (lo.Z + hi.Z) / 2)
	end
	if def.anchor and def.front then
		local dir = def.front.Position - def.anchor.Position
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 0.01 then
			return CFrame.lookAt(pos, pos + dir) -- prop "front" becomes the pivot's look direction
		end
	end
	return CFrame.new(pos)
end

-- Kit.spawn("Pillar", cframe, { scale = 1, parent = folder, tint = Color3, shadows = false, name = "..",
--                               motion = { kind = "bob" | "orbit" | "follow", ... } })
-- The prop's front (if it has one) points along cframe.LookVector.
function Kit.spawn(name, cf, opts)
	local def = props[name]
	if not def or #def.pieces == 0 then
		return nil
	end
	opts = opts or {}
	local scale = opts.scale or 1
	local motion = opts.motion
	local pivot = propPivot(def)

	local model = Instance.new("Model")
	model.Name = opts.name or name

	local root = Instance.new("Part")
	root.Name = "KitRoot"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CFrame = cf
	root.Parent = model
	model.PrimaryPart = root

	local animated = motion ~= nil
	for _, piece in ipairs(def.pieces) do
		local part = piece.part:Clone()
		local rel = pivot:ToObjectSpace(part.CFrame)
		rel = CFrame.new(rel.Position * scale) * rel.Rotation
		part.Name = piece.piece
		part.Size = part.Size * scale
		part.CFrame = cf * rel
		style(part, piece.color, opts)
		if piece.anim or motion then
			part:SetAttribute("KitRel", rel)
			if piece.anim then
				part:SetAttribute("KitAnim", piece.anim)
				animated = true
			end
		end
		part.Parent = model
	end

	if motion then
		model:SetAttribute("KitMotion", motion.kind)
		model:SetAttribute("KitBase", cf)
		model:SetAttribute("KitPhase", motion.phase or 0)
		model:SetAttribute("KitSpeed", motion.speed or 1)
		model:SetAttribute("KitAmp", motion.amp or 0)
		if motion.center then
			model:SetAttribute("KitCenter", motion.center)
		end
		if motion.radius then
			model:SetAttribute("KitRadius", motion.radius)
		end
		if motion.target then
			local ov = Instance.new("ObjectValue")
			ov.Name = "KitTarget"
			ov.Value = motion.target
			ov.Parent = model
		end
	end
	if opts.noCull then
		model:SetAttribute("KitNoCull", true)
	end
	if animated then
		CollectionService:AddTag(model, "KitModel")
	end
	model.Parent = opts.parent or workspace
	return model
end

-- Fade a spawned prop in (visible = true) or out (visible = false).
function Kit.fade(model, visible, seconds)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "KitRoot" then
			local goal = visible and (d:GetAttribute("KitT") or 0) or 1
			TweenService:Create(d, TweenInfo.new(seconds), { Transparency = goal }):Play()
		end
	end
end

-- Copies the named props into `folder` (in ReplicatedStorage) so client scripts (shop icons,
-- disaster effects) can clone them. They are untagged, so KitAnimator leaves the templates alone.
function Kit.publish(names, folder)
	for _, name in ipairs(names) do
		local model = Kit.spawn(name, CFrame.new(), { parent = folder, shadows = false })
		if model then
			CollectionService:RemoveTag(model, "KitModel")
		end
	end
end

function Kit.setTransparency(model, value)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "KitRoot" then
			d.Transparency = value
		end
	end
end

return Kit
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX_KitAnimator"><Properties><string name="Name">KitAnimator</string><bool name="Disabled">false</bool><token name="RunContext">2</token><ProtectedString name="Source"><![CDATA[-- KitAnimator  (Script with RunContext = Client, child of the LobbyUpgrade script)
--
-- LobbyUpgrade moves this into ReplicatedStorage when the game starts, so it runs on every
-- player's device. It plays all the kit animations locally (smooth, and free for the server):
--   * pieces with a KitAnim attribute spin / bob around their prop
--   * props with a KitMotion attribute float (bob), circle the lobby (orbit) or ride on a
--     lobby coin (follow)
--   * jump pads launch the local player

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local entries = {} -- [model] = entry

local function parseAnim(text)
	local spin, bob = 0, 0
	for token in string.gmatch(text, "[^_]+") do
		local n = tonumber(string.match(token, "^spin(-?[%d%.]+)$"))
		if n then
			spin = n
		end
		n = tonumber(string.match(token, "^bob(-?[%d%.]+)$"))
		if n then
			bob = n
		end
	end
	return math.rad(spin), bob
end

local function addPiece(entry, part)
	if not part:IsA("BasePart") or part.Name == "KitRoot" then
		return
	end
	local rel = part:GetAttribute("KitRel")
	if typeof(rel) ~= "CFrame" then
		return
	end
	local spin, bob = parseAnim(part:GetAttribute("KitAnim") or "")
	table.insert(entry.pieces, { part = part, rel = rel, spin = spin, bob = bob })
end

local function register(model)
	if entries[model] or not model:IsA("Model") then
		return
	end
	local entry = {
		pieces = {},
		motion = model:GetAttribute("KitMotion"),
		base = model:GetAttribute("KitBase"),
		phase = model:GetAttribute("KitPhase") or 0,
		speed = model:GetAttribute("KitSpeed") or 1,
		amp = model:GetAttribute("KitAmp") or 0,
		center = model:GetAttribute("KitCenter"),
		radius = model:GetAttribute("KitRadius") or 0,
		noCull = model:GetAttribute("KitNoCull") == true,
	}
	entries[model] = entry
	for _, child in ipairs(model:GetChildren()) do
		addPiece(entry, child)
	end
	entry.added = model.ChildAdded:Connect(function(child)
		task.defer(addPiece, entry, child)
	end)
end

local function unregister(model)
	local entry = entries[model]
	if entry then
		entry.added:Disconnect()
		entries[model] = nil
	end
end

CollectionService:GetInstanceAddedSignal("KitModel"):Connect(register)
CollectionService:GetInstanceRemovedSignal("KitModel"):Connect(unregister)
for _, model in ipairs(CollectionService:GetTagged("KitModel")) do
	register(model)
end

RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local camPos = camera.CFrame.Position
	local t = os.clock()
	local parts, cframes, n = {}, {}, 0

	for model, e in pairs(entries) do
		local root = e.root
		if not root or root.Parent ~= model then
			root = model:FindFirstChild("KitRoot")
			e.root = root
		end
		if root then
			local rootCF = root.CFrame
			local hidden = nil
			if e.motion == "bob" and e.base then
				rootCF = e.base * CFrame.new(0, math.sin(t * e.speed + e.phase) * e.amp, 0)
			elseif e.motion == "orbit" and e.center then
				local a = e.phase + t * math.rad(e.speed)
				local pos = e.center + Vector3.new(math.cos(a) * e.radius, math.sin(t * 0.6 + e.phase) * e.amp, math.sin(a) * e.radius)
				rootCF = CFrame.new(pos) * CFrame.Angles(0, -a, 0)
			elseif e.motion == "follow" then
				local holder = model:FindFirstChild("KitTarget")
				local target = holder and holder.Value
				if target and target.Parent then
					rootCF = CFrame.new(target.Position)
					hidden = target.Transparency > 0.9
					target.LocalTransparencyModifier = 1 -- the kit coin replaces the plain one on screen
				else
					hidden = true
				end
			end

			if e.noCull or (rootCF.Position - camPos).Magnitude < 700 then
				local bobT = math.sin(t * 1.6 + e.phase)
				for _, p in ipairs(e.pieces) do
					local part = p.part
					if part.Parent then
						local cf = rootCF
						if p.spin ~= 0 or p.bob ~= 0 then
							cf = cf * CFrame.new(0, bobT * p.bob, 0) * CFrame.Angles(0, t * p.spin, 0)
						end
						n += 1
						parts[n] = part
						cframes[n] = cf * p.rel
						if hidden ~= nil then
							part.LocalTransparencyModifier = hidden and 1 or 0
						end
					end
				end
			end
		end
	end

	if n > 0 then
		workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end)

--------------------------------------------------------------------
-- Jump pads
--------------------------------------------------------------------
local lastBounce = 0
local boing = Instance.new("Sound")
boing.SoundId = "rbxasset://sounds/electronicpingshort.wav"
boing.Volume = 0.7
boing.PlaybackSpeed = 0.55
boing.Parent = SoundService

local function hookPad(pad)
	if not pad:IsA("BasePart") then
		return
	end
	pad.Touched:Connect(function(hit)
		local character = player.Character
		if not character or not hit:IsDescendantOf(character) then
			return
		end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not hrp or not humanoid or humanoid.Health <= 0 then
			return
		end
		local now = os.clock()
		if now - lastBounce < 0.6 then
			return
		end
		lastBounce = now
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(v.X, pad:GetAttribute("Power") or 95, v.Z)
		SoundService:PlayLocalSound(boing)
	end)
end

CollectionService:GetInstanceAddedSignal("KitJumpPad"):Connect(hookPad)
for _, pad in ipairs(CollectionService:GetTagged("KitJumpPad")) do
	hookPad(pad)
end
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX_DisasterFX"><Properties><string name="Name">DisasterFX</string><bool name="Disabled">false</bool><token name="RunContext">2</token><ProtectedString name="Source"><![CDATA[-- DisasterFX  (Script with RunContext = Client, child of the LobbyUpgrade script)
--
-- LobbyUpgrade moves this into ReplicatedStorage when the game starts, so it runs on every
-- player's device. Everything here is visual/audio on that player's screen; damage, hit-boxes
-- and timings stay exactly as DisasterGameManager runs them. For every disaster:
--   * intro: the disaster's name slams onto the screen in big red letters
--   * extreme wind: flying Blender debris + wind streaks around the camera, gusting wind roar,
--     GlobalWind for grass/particles, and a push on your own character while on the island
--   * weather (rain / acid / snow / ash / embers / dust), colour grading, lightning flashes, rumble
--   * new Blender looks for the hazards: meteors, ice shards, acid drops, lava blobs + pools,
--     quake rings, lightning bolts, the shark and the tsunami wave (the old block looks are hidden
--     on this screen only). The tornado's new funnel is set up on the server by LobbyUpgrade.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

--------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------
local SHOW_INTRO = true
local REPLACE_HAZARD_LOOKS = true
local WIND_PUSH = 0.3          -- 0 = wind is visual only. Push = wind speed x this, in studs/s per second
local DEBRIS_COUNT = 30        -- flying Blender debris pieces around the camera
local STREAK_COUNT = 14        -- wind streaks around the camera
local TITLE_COLOR = Color3.fromRGB(235, 28, 28)

local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local WHITE = Color3.new(1, 1, 1)

-- Per base disaster. Mythic combos merge the profiles of their parts.
--   wind = studs/s, weather = list of weather kinds, shake = constant camera shake,
--   debris = Blender props blown around, flashes = lightning flashes, crackle = fire crackle loop
local C3 = Color3.fromRGB
local PROFILES = {
	MeteorShower = { wind = 40, weather = { "ash", "embers" }, tint = C3(255, 150, 100), shake = 0.25, debris = { "FxRock", "FxMeteorChunk" }, crackle = true },
	RisingFlood = { wind = 55, weather = { "rain" }, tint = C3(150, 195, 255), shake = 0.15, debris = { "FxLeaf", "FxDroplet" }, flashes = true },
	LightningStorm = { wind = 65, weather = { "rain" }, tint = C3(165, 165, 230), shake = 0.15, debris = { "FxLeaf", "FxPlank" }, flashes = true },
	Tsunami = { wind = 70, weather = { "rain" }, tint = C3(140, 200, 255), shake = 0.3, debris = { "FxDroplet", "FxLeaf" } },
	DragonAttack = { wind = 35, weather = { "embers", "ash" }, tint = C3(255, 150, 90), shake = 0.25, debris = { "FxRock" }, crackle = true },
	Tornado = { wind = 100, weather = { "rain", "dust" }, tint = C3(170, 185, 160), shake = 0.35, debris = { "FxPlank", "FxLeaf", "FxRock" }, flashes = true },
	VolcanicEruption = { wind = 35, weather = { "ash", "embers" }, tint = C3(255, 120, 80), shake = 0.35, debris = { "FxMeteorChunk", "FxRock" }, crackle = true },
	Earthquake = { wind = 30, weather = { "dust" }, tint = C3(225, 195, 150), shake = 0.6, debris = { "FxRock" } },
	AcidRain = { wind = 45, weather = { "acid" }, tint = C3(170, 255, 140), shake = 0.1, debris = { "FxLeaf" } },
	SharkAttack = { wind = 45, weather = { "rain" }, tint = C3(140, 220, 210), shake = 0.1, debris = { "FxDroplet" } },
	MoonCollision = { wind = 55, weather = { "dust", "embers" }, tint = C3(255, 170, 130), shake = 0.2, debris = { "FxRock", "FxMeteorChunk" } },
	Blizzard = { wind = 85, weather = { "snow" }, tint = C3(200, 230, 255), shake = 0.15, debris = { "FxIceShard" } },
}

--------------------------------------------------------------------
-- Setup
--------------------------------------------------------------------
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local assets = ReplicatedStorage:WaitForChild("DisasterAssets")
local remotes = assets:WaitForChild("Remotes")
local Config = require(assets:WaitForChild("DisasterConfig"))
local soundsFolder = assets:FindFirstChild("Sounds")
local props = ReplicatedStorage:WaitForChild("LobbyKitProps", 30) -- Blender templates (nil without the kit)

local fxFolder = Instance.new("Folder")
fxFolder.Name = "DisasterFXLocal"
fxFolder.Parent = workspace

local rng = Random.new()

local function mk(class, p, parent)
	local inst = Instance.new(class)
	for k, v in pairs(p) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function ns(...)
	local a, pts = { ... }, {}
	for i = 1, #a, 2 do
		table.insert(pts, NumberSequenceKeypoint.new(a[i], a[i + 1]))
	end
	return NumberSequence.new(pts)
end

local function ghost(cf, size)
	return mk("Part", {
		Size = size or Vector3.new(1, 1, 1),
		CFrame = cf,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		Transparency = 1,
	}, fxFolder)
end

local function emitter(parent, p)
	local base = { LightInfluence = 0, Rate = 0 }
	for k, v in pairs(p) do
		base[k] = v
	end
	return mk("ParticleEmitter", base, parent)
end

local function cloneProp(name, scale, tint)
	local t = props and props:FindFirstChild(name)
	if not t then
		return nil
	end
	local m = t:Clone()
	if scale and math.abs(scale - 1) > 0.01 then
		m:ScaleTo(scale)
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CastShadow = false
			if tint and d.Material == Enum.Material.Neon then
				d.Color = tint
			end
		end
	end
	m.Parent = fxFolder
	return m
end

local function setModelFade(model, alpha)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = alpha
		end
	end
end

-- sounds come from the game's own DisasterAssets > Sounds (so every id is one the game already uses)
local function sound(name, p, parent)
	local t = soundsFolder and soundsFolder:FindFirstChild(name)
	if not t or not t:IsA("Sound") then
		return nil
	end
	local s = t:Clone()
	s.Looped = false
	for k, v in pairs(p or {}) do
		s[k] = v
	end
	s.Parent = parent or SoundService
	return s
end

local function oneShot(name, volume, speed, position)
	local holder = position and ghost(CFrame.new(position)) or nil
	local s = sound(name, { Volume = volume, PlaybackSpeed = speed, RollOffMaxDistance = 600 }, holder)
	if s then
		s:Play()
		Debris:AddItem(holder or s, 10)
	elseif holder then
		holder:Destroy()
	end
end

--------------------------------------------------------------------
-- Camera shake (constant level + short kicks)
--------------------------------------------------------------------
local shakeBase = 0
local kicks = {}
local function kick(amp, duration)
	table.insert(kicks, { amp = amp, t = os.clock(), dur = duration })
end

RunService:BindToRenderStep("DisasterFXShake", Enum.RenderPriority.Camera.Value + 1, function()
	if camera.CameraType ~= Enum.CameraType.Custom then
		return -- a scripted camera does not reset every frame, so the offsets would add up
	end
	local now = os.clock()
	local amp = shakeBase
	for i = #kicks, 1, -1 do
		local k = kicks[i]
		local a = (now - k.t) / k.dur
		if a >= 1 then
			table.remove(kicks, i)
		else
			amp += k.amp * (1 - a) ^ 2
		end
	end
	if amp > 0.001 then
		local t = now * 26
		camera.CFrame *= CFrame.Angles(math.noise(t, 0.3) * amp * 0.035, math.noise(0.7, t) * amp * 0.035, math.noise(t, t * 0.5) * amp * 0.02)
	end
end)

--------------------------------------------------------------------
-- Intro card: the name in big red letters
--------------------------------------------------------------------
local playerGui = player:WaitForChild("PlayerGui")
local introGui = mk("ScreenGui", { Name = "DisasterIntro", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 40, Enabled = false }, playerGui)
local flash = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C3(255, 40, 40), BackgroundTransparency = 1, BorderSizePixel = 0 }, introGui)
local barTop = mk("Frame", { Size = UDim2.fromScale(1, 0), BackgroundColor3 = C3(0, 0, 0), BorderSizePixel = 0 }, introGui)
local barBottom = mk("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = C3(0, 0, 0), BorderSizePixel = 0 }, introGui)
local title = mk("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.42),
	Size = UDim2.fromScale(0.92, 0.22),
	BackgroundTransparency = 1,
	Font = Enum.Font.LuckiestGuy,
	TextScaled = true,
	TextColor3 = TITLE_COLOR,
	Text = "",
}, introGui)
mk("UITextSizeConstraint", { MaxTextSize = 150 }, title)
local titleStroke = mk("UIStroke", { Color = C3(20, 0, 0), Thickness = 6, LineJoinMode = Enum.LineJoinMode.Round }, title)
mk("UIGradient", { Rotation = 90, Color = ColorSequence.new(C3(255, 255, 255), C3(160, 150, 150)) }, title)
local titleScale = mk("UIScale", { Scale = 1 }, title)
local subtitle = mk("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.fromScale(0.5, 0.54),
	Size = UDim2.fromScale(0.7, 0.06),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	TextScaled = true,
	TextColor3 = WHITE,
	Text = "",
}, introGui)
local subStroke = mk("UIStroke", { Color = C3(0, 0, 0), Thickness = 3 }, subtitle)

local introToken = 0
local function tween(obj, t, goal, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

local function playIntro(def)
	introToken += 1
	local token = introToken
	local rarity = Config.Rarities and Config.Rarities[def.Rarity or "Common"]
	title.Text = string.upper(def.Name)
	subtitle.Text = ("⚠  %s DISASTER  ⚠"):format(string.upper(def.Rarity or "Common"))
	subtitle.TextColor3 = rarity and rarity.Color or WHITE
	titleScale.Scale = 4
	title.Rotation = -10
	title.TextTransparency = 1
	titleStroke.Transparency = 1
	subtitle.TextTransparency = 1
	subStroke.Transparency = 1
	introGui.Enabled = true

	tween(barTop, 0.25, { Size = UDim2.fromScale(1, 0.11) })
	tween(barBottom, 0.25, { Size = UDim2.fromScale(1, 0.11) })
	oneShot("Whoosh", 0.9, 0.7)
	tween(titleScale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(title, 0.32, { Rotation = 0, TextTransparency = 0 }, Enum.EasingStyle.Back)
	tween(titleStroke, 0.2, { Transparency = 0 })

	task.delay(0.3, function()
		if token ~= introToken then
			return
		end
		-- the slam
		flash.BackgroundTransparency = 0.35
		tween(flash, 0.5, { BackgroundTransparency = 1 })
		oneShot("Explosion", 1, 0.75)
		oneShot("Thunder", 0.8, 0.6)
		kick(1.6, 0.6)
		for i = 1, 6 do -- quick rattle of the letters
			title.Position = UDim2.new(0.5, rng:NextInteger(-9, 9), 0.42, rng:NextInteger(-6, 6))
			task.wait(0.035)
		end
		title.Position = UDim2.fromScale(0.5, 0.42)
		tween(subtitle, 0.3, { TextTransparency = 0 })
		tween(subStroke, 0.3, { Transparency = 0 })
		tween(titleScale, 0.8, { Scale = 1.06 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	end)

	task.delay(2.4, function()
		if token ~= introToken then
			return
		end
		tween(titleScale, 0.35, { Scale = 1.35 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(title, 0.35, { TextTransparency = 1 })
		tween(titleStroke, 0.3, { Transparency = 1 })
		tween(subtitle, 0.3, { TextTransparency = 1 })
		tween(subStroke, 0.3, { Transparency = 1 })
		tween(barTop, 0.35, { Size = UDim2.fromScale(1, 0) })
		tween(barBottom, 0.35, { Size = UDim2.fromScale(1, 0) }).Completed:Wait()
		if token == introToken then
			introGui.Enabled = false
		end
	end)
end

--------------------------------------------------------------------
-- Impacts (used by the hazard looks)
--------------------------------------------------------------------
local function impact(pos, color, chunkName, big)
	local dist = (camera.CFrame.Position - pos).Magnitude
	kick(math.clamp(1 - dist / 170, 0, 1) * (big and 1.6 or 0.8), 0.45)

	local holder = ghost(CFrame.new(pos), Vector3.new(4, 1, 4))
	emitter(holder, {
		Texture = TEX_SMOKE,
		Color = ColorSequence.new(C3(110, 95, 85)),
		Size = ns(0, 4, 1, big and 18 or 10),
		Transparency = ns(0, 0.3, 1, 1),
		Lifetime = NumberRange.new(1, 2.2),
		Speed = NumberRange.new(10, big and 30 or 18),
		SpreadAngle = Vector2.new(80, 80),
		EmissionDirection = Enum.NormalId.Top,
		Drag = 2.5,
	}):Emit(big and 30 or 14)
	emitter(holder, {
		Texture = TEX_SPARK,
		Color = ColorSequence.new(color, WHITE),
		LightEmission = 1,
		Size = ns(0, 1.2, 1, 0),
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(25, 55),
		SpreadAngle = Vector2.new(70, 70),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -60, 0),
	}):Emit(big and 50 or 20)
	local light = mk("PointLight", { Color = color, Range = big and 45 or 25, Brightness = 6 }, holder)
	tween(light, 0.7, { Brightness = 0 })
	Debris:AddItem(holder, 3)

	-- expanding shock ring
	local ring = cloneProp("FxShockRing", 0.3, color)
	if ring then
		local base = CFrame.new(pos + Vector3.new(0, 0.6, 0))
		local grow = big and 3.2 or 1.6
		task.spawn(function()
			local t0 = os.clock()
			while ring.Parent do
				local a = math.min((os.clock() - t0) / 0.55, 1)
				ring:ScaleTo(0.3 + (grow - 0.3) * (1 - (1 - a) ^ 3))
				ring:PivotTo(base)
				setModelFade(ring, a)
				if a >= 1 then
					break
				end
				RunService.RenderStepped:Wait()
			end
			ring:Destroy()
		end)
	end

	-- Blender chunks flung out
	if chunkName then
		for _ = 1, big and 7 or 4 do
			local chunk = cloneProp(chunkName, rng:NextNumber(0.6, 1.2))
			if chunk then
				local vel = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.8, 1.6), rng:NextNumber(-1, 1)) * (big and 38 or 24)
				local spin = CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3))
				task.spawn(function()
					local p, rot, t0 = pos, CFrame.new(), os.clock()
					while chunk.Parent and os.clock() - t0 < 1.4 do
						local dt = RunService.RenderStepped:Wait()
						vel += Vector3.new(0, -110, 0) * dt
						p += vel * dt
						rot *= spin
						chunk:PivotTo(CFrame.new(p) * rot)
						setModelFade(chunk, math.max(0, (os.clock() - t0 - 0.9) / 0.5))
					end
					chunk:Destroy()
				end)
			end
		end
	end
end

--------------------------------------------------------------------
-- New hazard looks (follow the real hazard, hide its old look on this screen)
--------------------------------------------------------------------
local swaps = {} -- [hazard] = { model, host, pose(hostCF, t), fade = bool, onGone(lastCF), extra = {models} }

local function hideLook(inst)
	if inst:IsA("BasePart") then
		inst.LocalTransparencyModifier = 1
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = 1
		end
	end
end

local function track(hazard, entry)
	entry.lastCF = entry.host.CFrame
	entry.born = os.clock()
	swaps[hazard] = entry
end

local function yawSpin(speed, phase)
	return function(cf, t)
		return CFrame.new(cf.Position) * CFrame.Angles(0, t * speed + phase, 0)
	end
end

local LOOKS = {}

LOOKS.Meteor = function(part)
	local model = cloneProp("MeteorRock", part.Size.X / 8)
	if not model then
		return
	end
	hideLook(part)
	local rock = model:FindFirstChild("rock")
	if rock then
		emitter(rock, {
			Texture = TEX_FIRE,
			Color = ColorSequence.new(C3(255, 200, 80), C3(255, 70, 20)),
			LightEmission = 1,
			Size = ns(0, 7, 1, 0),
			Transparency = ns(0, 0.1, 1, 1),
			Lifetime = NumberRange.new(0.4, 0.7),
			Speed = NumberRange.new(12, 24),
			EmissionDirection = Enum.NormalId.Top,
			Rate = 70,
		})
	end
	track(part, {
		model = model,
		host = part,
		pose = yawSpin(4, rng:NextNumber(0, 6)),
		onGone = function(cf)
			impact(cf.Position, C3(255, 140, 40), "FxMeteorChunk", true)
			oneShot("Explosion", 0.8, 0.55, cf.Position)
		end,
	})
end

LOOKS.IceShard = function(part)
	local model = cloneProp("IceCrystal", 1.5)
	if not model then
		return
	end
	hideLook(part)
	track(part, {
		model = model,
		host = part,
		pose = yawSpin(3, rng:NextNumber(0, 6)),
		onGone = function(cf)
			impact(cf.Position, C3(170, 225, 255), "FxIceShard", false)
		end,
	})
end

LOOKS.AcidDrop = function(part)
	local model = cloneProp("AcidBlob", part.Size.X / 2.5)
	if not model then
		return
	end
	hideLook(part)
	track(part, {
		model = model,
		host = part,
		pose = yawSpin(2, 0),
		onGone = function(cf)
			impact(cf.Position, C3(140, 255, 60), nil, false)
		end,
	})
end

local function lavaCube(part)
	local model = cloneProp("LavaBlob", part.Size.X / 5)
	if not model then
		return
	end
	hideLook(part)
	local spin = CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
	track(part, {
		model = model,
		host = part,
		fade = true,
		pose = function(cf, t)
			return CFrame.new(cf.Position) * spin * CFrame.Angles(t * 3, t * 2, 0)
		end,
	})
end

LOOKS.LavaPool = function(part)
	local model = cloneProp("LavaPool", part.Size.X / 18)
	if not model then
		return
	end
	hideLook(part)
	local lava = model:FindFirstChild("lava")
	if lava then
		emitter(lava, {
			Texture = TEX_SPARK,
			Color = ColorSequence.new(C3(255, 170, 60), C3(255, 60, 20)),
			LightEmission = 1,
			Size = ns(0, 0.6, 1, 0),
			Lifetime = NumberRange.new(1, 2),
			Speed = NumberRange.new(4, 10),
			EmissionDirection = Enum.NormalId.Top,
			Rate = 18,
		})
		mk("PointLight", { Color = C3(255, 120, 40), Range = 22, Brightness = 2 }, lava)
	end
	track(part, {
		model = model,
		host = part,
		fade = true,
		pose = function(cf)
			return CFrame.new(cf.Position)
		end,
	})
end

LOOKS.QuakeRing = function(part)
	if not (props and props:FindFirstChild("QuakeSpike")) then
		return
	end
	hideLook(part)
	local spikes = {}
	for i = 1, 26 do
		local s = cloneProp("QuakeSpike", rng:NextNumber(1.2, 1.9))
		if s then
			table.insert(spikes, { model = s, a = (i / 26) * math.pi * 2, yaw = rng:NextNumber(0, 6), tilt = rng:NextNumber(-0.25, 0.25) })
			if i % 5 == 0 then
				local rockPart = s:FindFirstChild("rock")
				if rockPart then
					emitter(rockPart, {
						Texture = TEX_SMOKE,
						Color = ColorSequence.new(C3(190, 160, 120)),
						Size = ns(0, 3, 1, 8),
						Transparency = ns(0, 0.5, 1, 1),
						Lifetime = NumberRange.new(0.8, 1.6),
						Speed = NumberRange.new(4, 9),
						EmissionDirection = Enum.NormalId.Top,
						Rate = 12,
					})
				end
			end
		end
	end
	track(part, {
		model = nil,
		host = part,
		extra = spikes,
		update = function()
			local r = part.Size.Y / 2
			local base = part.Position - Vector3.new(0, 0.5, 0)
			for _, s in ipairs(spikes) do
				local p = base + Vector3.new(math.cos(s.a) * r, 0, math.sin(s.a) * r)
				s.model:PivotTo(CFrame.new(p) * CFrame.Angles(s.tilt, s.yaw, 0))
			end
		end,
	})
end

LOOKS.LightningBolt = function(model)
	if not (props and props:FindFirstChild("FxBolt")) then
		return
	end
	task.defer(function() -- the segments are parented before the model, but wait one step to be safe
		local top, bottom, first
		for _, seg in ipairs(model:GetChildren()) do
			if seg:IsA("BasePart") then
				first = first or seg
				local hi = seg.Position + Vector3.new(0, seg.Size.Y / 2, 0)
				local lo = seg.Position - Vector3.new(0, seg.Size.Y / 2, 0)
				if not top or hi.Y > top.Y then
					top = hi
				end
				if not bottom or lo.Y < bottom.Y then
					bottom = lo
				end
			end
		end
		if not top then
			return
		end
		hideLook(model)
		local height = math.max(top.Y - bottom.Y, 10)
		local color = C3(255, 245, 170)
		local main = cloneProp("FxBolt", height / 40, color)
		local branches = {}
		for i = 1, 2 do
			local b = cloneProp("FxBolt", height / 40 * rng:NextNumber(0.25, 0.4), C3(170, 220, 255))
			if b then
				table.insert(branches, { model = b, f = rng:NextNumber(0.2, 0.6), cf = CFrame.Angles(rng:NextNumber(-0.7, 0.7), rng:NextNumber(0, 6), rng:NextNumber(0.4, 0.8) * (i == 1 and 1 or -1)) })
			end
		end
		if not main then
			return
		end
		local topCF = CFrame.new(Vector3.new(bottom.X, top.Y, bottom.Z)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
		local mainPart = main:FindFirstChild("bolt")
		if mainPart then
			mk("PointLight", { Color = color, Range = 60, Brightness = 10 }, mainPart)
		end
		impact(bottom, color, "FxRock", false)
		local host = first
		track(model, {
			model = main,
			host = host,
			fade = true,
			extra = branches,
			pose = function()
				return topCF
			end,
			update = function()
				for _, b in ipairs(branches) do
					b.model:PivotTo(topCF * CFrame.new(0, -height * b.f, 0) * b.cf)
					setModelFade(b.model, host.Transparency)
				end
			end,
		})
	end)
end

LOOKS.Shark = function(model)
	task.defer(function()
		local body = model:FindFirstChild("Body")
		local look = body and cloneProp("Shark", 1)
		if not look then
			return
		end
		hideLook(model)
		track(model, {
			model = look,
			host = body,
			pose = function(cf, t)
				return cf * CFrame.Angles(0, math.sin(t * 6) * 0.12, 0) -- tail-wag sway
			end,
		})
	end)
end

LOOKS.TsunamiWave = function(part)
	local look = cloneProp("TsunamiCurl", 1)
	if not look then
		return
	end
	-- stretch only along the wall (X) so the curl keeps the hit-box height
	local sx = part.Size.X / 250
	local pivot = look:GetPivot()
	for _, d in ipairs(look:GetDescendants()) do
		if d:IsA("BasePart") then
			local rel = pivot:ToObjectSpace(d.CFrame)
			d.Size = Vector3.new(d.Size.X * sx, d.Size.Y, d.Size.Z)
			d.CFrame = pivot * (CFrame.new(rel.Position.X * sx, rel.Position.Y, rel.Position.Z) * rel.Rotation)
		end
	end
	local folder = part.Parent
	if folder then
		hideLook(folder)
		local conn = folder.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 1
			end
		end)
		look.Destroying:Once(function()
			conn:Disconnect()
		end)
	end
	local foam = look:FindFirstChild("foam")
	if foam then
		emitter(foam, {
			Texture = TEX_SMOKE,
			Color = ColorSequence.new(C3(235, 248, 255)),
			Size = ns(0, 6, 1, 18),
			Transparency = ns(0, 0.35, 1, 1),
			Lifetime = NumberRange.new(1, 2),
			Speed = NumberRange.new(10, 30),
			SpreadAngle = Vector2.new(40, 40),
			EmissionDirection = Enum.NormalId.Top,
			Rate = 120,
		})
	end
	track(part, {
		model = look,
		host = part,
		pose = function(cf)
			return cf
		end,
	})
end

LOOKS.DisasterFlood = function(part)
	-- keep the water, add mist rolling over its surface
	emitter(part, {
		Texture = TEX_SMOKE,
		Color = ColorSequence.new(C3(220, 240, 255)),
		Size = ns(0, 8, 1, 20),
		Transparency = ns(0, 0.75, 1, 1),
		Lifetime = NumberRange.new(2, 4),
		Speed = NumberRange.new(2, 6),
		EmissionDirection = Enum.NormalId.Top,
		Rate = 40,
	})
end

local function onHazard(inst)
	if inst:IsDescendantOf(fxFolder) then
		return -- our own Blender copies share names with the hazards (Shark, LavaPool ...)
	end
	local name = inst.Name
	local fn = LOOKS[name]
	if not fn and string.sub(name, 1, 8) == "LavaCube" and inst:IsA("BasePart") then
		fn = lavaCube
	end
	if fn and not swaps[inst] then
		local ok, err = pcall(fn, inst)
		if not ok then
			warn("[DisasterFX] " .. name .. " look failed: " .. tostring(err))
		end
	end
end

local function dropSwap(hazard, entry)
	swaps[hazard] = nil
	if entry.onGone then
		pcall(entry.onGone, entry.lastCF)
	end
	if entry.model then
		entry.model:Destroy()
	end
	for _, e in ipairs(entry.extra or {}) do
		e.model:Destroy()
	end
end

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	for hazard, entry in pairs(swaps) do
		if not hazard.Parent or not entry.host.Parent then
			dropSwap(hazard, entry)
		else
			entry.lastCF = entry.host.CFrame
			if entry.model and entry.pose then
				entry.model:PivotTo(entry.pose(entry.lastCF, now - entry.born))
				if entry.fade then
					setModelFade(entry.model, entry.host.Transparency)
				end
			end
			if entry.update then
				entry.update()
			end
		end
	end
end)

--------------------------------------------------------------------
-- Weather, wind, grading, ambience
--------------------------------------------------------------------
local active = nil -- the running disaster's state

local WEATHER = {
	rain = { Texture = TEX_SPARK, Color = ColorSequence.new(C3(190, 215, 255)), Size = ns(0, 0.22, 1, 0.22), Transparency = ns(0, 0.2, 1, 0.4),
		Lifetime = NumberRange.new(1.1, 1.3), Speed = NumberRange.new(95, 115), Rate = 900, LightEmission = 0.3,
		EmissionDirection = Enum.NormalId.Bottom, Orientation = Enum.ParticleOrientation.VelocityParallel },
	acid = { Texture = TEX_SPARK, Color = ColorSequence.new(C3(150, 255, 70)), Size = ns(0, 0.28, 1, 0.28), Transparency = ns(0, 0.1, 1, 0.3),
		Lifetime = NumberRange.new(1.1, 1.3), Speed = NumberRange.new(85, 105), Rate = 700, LightEmission = 0.8,
		EmissionDirection = Enum.NormalId.Bottom, Orientation = Enum.ParticleOrientation.VelocityParallel },
	snow = { Texture = TEX_SPARK, Color = ColorSequence.new(WHITE), Size = ns(0, 0.5, 1, 0.35), Transparency = ns(0, 0, 1, 0.3),
		Lifetime = NumberRange.new(4, 6), Speed = NumberRange.new(14, 22), Rate = 600, RotSpeed = NumberRange.new(-90, 90),
		EmissionDirection = Enum.NormalId.Bottom },
	ash = { Texture = TEX_SMOKE, Color = ColorSequence.new(C3(70, 62, 60)), Size = ns(0, 0.6, 1, 0.3), Transparency = ns(0, 0.2, 1, 0.6),
		Lifetime = NumberRange.new(4, 6), Speed = NumberRange.new(6, 12), Rate = 260, RotSpeed = NumberRange.new(-60, 60),
		EmissionDirection = Enum.NormalId.Bottom },
	embers = { Texture = TEX_SPARK, Color = ColorSequence.new(C3(255, 190, 80), C3(255, 70, 20)), Size = ns(0, 0.45, 1, 0), LightEmission = 1,
		Lifetime = NumberRange.new(3, 5), Speed = NumberRange.new(4, 10), Rate = 120, EmissionDirection = Enum.NormalId.Bottom },
	dust = { Texture = TEX_SMOKE, Color = ColorSequence.new(C3(200, 170, 130)), Size = ns(0, 6, 1, 14), Transparency = ns(0, 0.75, 0.5, 0.65, 1, 1),
		Lifetime = NumberRange.new(3, 5), Speed = NumberRange.new(4, 10), Rate = 30, EmissionDirection = Enum.NormalId.Bottom },
}

local function mergeProfile(def)
	local parts = def.Combo or { def.Id }
	local p = { wind = 0, weather = {}, debris = {}, shake = 0, tint = def.Color or WHITE }
	local seen = {}
	for _, id in ipairs(parts) do
		local base = PROFILES[id]
		if base then
			p.wind = math.max(p.wind, base.wind)
			p.shake = math.max(p.shake, base.shake)
			p.flashes = p.flashes or base.flashes
			p.crackle = p.crackle or base.crackle
			if not def.Combo then
				p.tint = base.tint
			end
			for _, w in ipairs(base.weather) do
				if not seen[w] then
					seen[w] = true
					table.insert(p.weather, w)
				end
			end
			for _, d in ipairs(base.debris) do
				table.insert(p.debris, d)
			end
		end
	end
	if def.Combo then
		p.wind += 15 -- mythic combos blow harder
		p.shake += 0.1
	end
	if p.wind == 0 then
		p.wind, p.weather, p.debris, p.shake = 45, { "dust" }, { "FxLeaf", "FxRock" }, 0.2
	end
	return p
end

local function lobbyCenter()
	local lobby = workspace:FindFirstChild("Lobby")
	local origin = lobby and lobby:GetAttribute("Origin")
	return typeof(origin) == "Vector3" and origin or nil
end

local function stopDisaster()
	local s = active
	active = nil
	if not s then
		return
	end
	s.alive = false
	shakeBase = 0
	workspace.GlobalWind = s.oldWind
	for _, c in ipairs(s.conns) do
		c:Disconnect()
	end
	for _, snd in ipairs(s.loops) do
		tween(snd, 2, { Volume = 0 })
		Debris:AddItem(snd, 2.2)
	end
	for _, e in ipairs(s.emitters) do
		e.Enabled = false
	end
	Debris:AddItem(s.weatherPart, 7)
	for _, d in ipairs(s.debris) do
		d.model:Destroy()
	end
	if s.cc then
		local cc = s.cc
		tween(cc, 2, { TintColor = WHITE, Saturation = 0, Contrast = 0, Brightness = 0 })
		Debris:AddItem(cc, 2.2)
	end
end

local function startDisaster(def)
	stopDisaster()
	local p = mergeProfile(def)
	local s = {
		alive = true,
		profile = p,
		conns = {},
		loops = {},
		emitters = {},
		debris = {},
		oldWind = workspace.GlobalWind,
		angle = rng:NextNumber(0, math.pi * 2),
		dir = Vector3.new(1, 0, 0),
		speed = 0,
	}
	active = s
	shakeBase = p.shake * 0.35

	-- colour grading
	s.cc = mk("ColorCorrectionEffect", { Name = "DisasterFX" }, Lighting)
	tween(s.cc, 1.5, { TintColor = p.tint:Lerp(WHITE, 0.55), Saturation = -0.12, Contrast = 0.14 })

	-- weather around the camera
	s.weatherPart = ghost(CFrame.new(camera.CFrame.Position), Vector3.new(150, 1, 150))
	for _, kind in ipairs(p.weather) do
		local spec = WEATHER[kind]
		if spec then
			table.insert(s.emitters, emitter(s.weatherPart, spec))
		end
	end

	-- ambience: wind roar, low rumble, fire crackle
	local wind = sound("Whoosh", { Looped = true, Volume = 0, PlaybackSpeed = 0.42 })
	local rumble = sound("Thunder", { Looped = true, Volume = 0, PlaybackSpeed = 0.3 })
	local crackle = p.crackle and sound("DragonFire", { Looped = true, Volume = 0, PlaybackSpeed = 0.55 }) or nil
	for _, snd in ipairs({ wind, rumble, crackle }) do
		if snd then
			snd:Play()
			table.insert(s.loops, snd)
		end
	end
	if rumble then
		tween(rumble, 2, { Volume = math.clamp(p.shake, 0.15, 0.6) })
	end
	if crackle then
		tween(crackle, 2, { Volume = 0.3 })
	end

	-- flying Blender debris + wind streaks
	local kinds = p.debris
	for i = 1, DEBRIS_COUNT + STREAK_COUNT do
		local isStreak = i > DEBRIS_COUNT
		local name = isStreak and "FxWindStreak" or kinds[((i - 1) % math.max(#kinds, 1)) + 1]
		local model = name and cloneProp(name, isStreak and rng:NextNumber(1.2, 2.2) or rng:NextNumber(0.7, 1.4))
		if model then
			table.insert(s.debris, {
				model = model,
				streak = isStreak,
				pos = nil, -- placed on the first frame
				speedK = isStreak and rng:NextNumber(1.3, 1.8) or rng:NextNumber(0.55, 1.05),
				spin = CFrame.Angles(rng:NextNumber(-4, 4), rng:NextNumber(-4, 4), rng:NextNumber(-4, 4)),
				rot = CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)),
				wobble = rng:NextNumber(0, 10),
			})
		end
	end

	local function respawn(d, camPos, fresh)
		local side = s.dir:Cross(Vector3.yAxis)
		local back = fresh and rng:NextNumber(-70, 70) or -75
		d.pos = camPos + s.dir * back + side * rng:NextNumber(-70, 70) + Vector3.new(0, rng:NextNumber(-8, 45), 0)
	end

	-- lightning flashes for the stormy ones
	if p.flashes then
		task.spawn(function()
			while s.alive do
				task.wait(rng:NextNumber(2, 6))
				if not s.alive then
					break
				end
				for _ = 1, rng:NextInteger(1, 2) do
					s.cc.Brightness = 0.45
					task.wait(0.06)
					s.cc.Brightness = 0
					task.wait(0.08)
				end
				task.delay(rng:NextNumber(0.3, 1.2), oneShot, "Thunder", rng:NextNumber(0.4, 0.7), rng:NextNumber(0.8, 1.1))
			end
		end)
	end

	local t0 = os.clock()
	local lastAccel = 0
	table.insert(s.conns, RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - t0
		local ramp = math.clamp(t / 2.5, 0, 1)
		-- gusting wind that slowly swings around
		local gust = 0.8 + 0.45 * math.noise(t * 0.35, 1.7)
		s.speed = p.wind * gust * ramp
		local a = s.angle + 0.6 * math.noise(t * 0.08, 4.2)
		s.dir = Vector3.new(math.cos(a), 0, math.sin(a))
		workspace.GlobalWind = s.dir * math.min(s.speed, 80) * 0.6
		if wind then
			wind.Volume = math.clamp(s.speed / 110, 0, 1) * 0.9
			wind.PlaybackSpeed = 0.35 + gust * 0.12
		end
		shakeBase = p.shake * 0.35 * (0.6 + 0.6 * gust) * ramp

		local camPos = camera.CFrame.Position
		s.weatherPart.CFrame = CFrame.new(camPos + Vector3.new(0, 48, 0) - s.dir * s.speed * 0.4)
		if os.clock() - lastAccel > 0.2 then
			lastAccel = os.clock()
			local accel = s.dir * s.speed * 0.7
			for _, e in ipairs(s.emitters) do
				e.Acceleration = accel
			end
		end

		for _, d in ipairs(s.debris) do
			if not d.pos then
				respawn(d, camPos, true)
			end
			local rel = d.pos - camPos
			if rel:Dot(s.dir) > 80 or rel.Magnitude > 120 then
				respawn(d, camPos, false)
			end
			local v = s.dir * s.speed * d.speedK + Vector3.new(0, math.sin(t * 2 + d.wobble) * (d.streak and 1.5 or 5), 0)
			d.pos += v * dt
			if d.streak then
				d.model:PivotTo(CFrame.fromMatrix(d.pos, s.dir, Vector3.yAxis))
			else
				d.rot = d.rot:Lerp(d.rot * d.spin, math.min(dt, 0.1))
				d.model:PivotTo(CFrame.new(d.pos) * d.rot)
			end
		end
	end))

	-- extreme wind pushes your own character (not in the lobby)
	if WIND_PUSH > 0 then
		table.insert(s.conns, RunService.Heartbeat:Connect(function(dt)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root or root.Anchored then
				return
			end
			local lobby = lobbyCenter()
			if lobby and (root.Position - lobby).Magnitude < 160 then
				return
			end
			root.AssemblyLinearVelocity += s.dir * s.speed * WIND_PUSH * dt
		end))
	end

	-- new hazard looks
	if REPLACE_HAZARD_LOOKS then
		table.insert(s.conns, workspace.DescendantAdded:Connect(onHazard))
		for _, d in ipairs(workspace:GetDescendants()) do -- anything that spawned before we heard about it
			if LOOKS[d.Name] then
				onHazard(d)
			end
		end
	end
end

--------------------------------------------------------------------
-- Wiring
--------------------------------------------------------------------
remotes:WaitForChild("DisasterStarted").OnClientEvent:Connect(function(disasterId)
	local def = Config.GetDisasterById(disasterId)
	if not def then
		return
	end
	if SHOW_INTRO then
		task.spawn(playIntro, def)
	end
	local ok, err = pcall(startDisaster, def)
	if not ok then
		warn("[DisasterFX] start failed: " .. tostring(err))
	end
end)

remotes:WaitForChild("DisasterEnded").OnClientEvent:Connect(function()
	local ok, err = pcall(stopDisaster)
	if not ok then
		warn("[DisasterFX] stop failed: " .. tostring(err))
	end
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX_ShopUI"><Properties><string name="Name">ShopUI</string><bool name="Disabled">false</bool><token name="RunContext">2</token><ProtectedString name="Source"><![CDATA[-- ShopUI  (Script with RunContext = Client, child of the LobbyUpgrade script)
--
-- LobbyUpgrade moves this into ReplicatedStorage so it runs on every player's device.
-- It replaces the old list-style shop with big colourful cards (3D Blender icons):
--   Eggs (pet odds + Buy x1 / x3 / x10) - Coin Packs - Survival Gear - Boosts (passes) - Trails - Free Item
-- Nothing about buying changes: it uses the same remotes as before
-- (ProgressionRemotes for trails / passes / products / daily, PetRemotes for hatching).
-- Whenever the old Shop panel opens (menu button or lobby kiosk) it is closed and this one opens.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Items = require(ReplicatedStorage:WaitForChild("ShopItems"))
local Config = require(ReplicatedStorage:WaitForChild("ProgressionConfig"))
local PetConfig = require(ReplicatedStorage:WaitForChild("PetConfig"))
local PetModelBuilder = require(ReplicatedStorage:WaitForChild("PetModelBuilder"))
local remotes = ReplicatedStorage:WaitForChild("ProgressionRemotes")
local petRequest = ReplicatedStorage:WaitForChild("PetRemotes"):WaitForChild("PetRequest")
local props = ReplicatedStorage:WaitForChild("LobbyKitProps", 30)

Items.AddProducts(Config) -- so the new coin packs can be looked up here too

local DataUpdate = remotes:WaitForChild("DataUpdate")
local RequestData = remotes:WaitForChild("RequestData")
local BuyCosmetic = remotes:WaitForChild("BuyCosmetic")
local EquipCosmetic = remotes:WaitForChild("EquipCosmetic")
local ClaimDaily = remotes:WaitForChild("ClaimDaily")
local PromptPass = remotes:WaitForChild("PromptPass")
local PromptProduct = remotes:WaitForChild("PromptProduct")
local ShopOpened = remotes:WaitForChild("ShopOpened")
local Notify = remotes:WaitForChild("Notify")

--------------------------------------------------------------------
-- Style
--------------------------------------------------------------------
local C3 = Color3.fromRGB
local WHITE = C3(255, 255, 255)
local INK = C3(20, 18, 30)
local GREEN_TOP, GREEN_BOT = C3(120, 255, 70), C3(40, 200, 20)
local GREY_TOP, GREY_BOT = C3(170, 175, 190), C3(110, 115, 130)
local FONT = Enum.Font.FredokaOne
local TITLE_FONT = Enum.Font.LuckiestGuy
local ROBUX = utf8.char(0xE002) -- Roblox renders this as the Robux icon

local function mk(class, p, parent)
	local inst = Instance.new(class)
	for k, v in pairs(p) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end
local function corner(parent, px)
	return mk("UICorner", { CornerRadius = UDim.new(0, px or 14) }, parent)
end
local function stroke(parent, thickness, color)
	return mk("UIStroke", { Thickness = thickness or 3, Color = color or INK, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, parent)
end
local function gradient(parent, top, bottom, rotation)
	return mk("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 }, parent)
end
local function text(parent, p)
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = WHITE,
		TextScaled = true,
	}
	for k, v in pairs(p) do
		if k ~= "StrokeThickness" then
			base[k] = v
		end
	end
	local l = mk("TextLabel", base, parent)
	stroke(l, p.StrokeThickness or 2.5)
	return l
end
local function fmt(n)
	local s = tostring(math.floor(n))
	while true do
		local k
		s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			return s
		end
	end
end

--------------------------------------------------------------------
-- 3D icons (ViewportFrames that slowly turn while the shop is open)
--------------------------------------------------------------------
local spinners = {}

local function viewport(parent, model, opts)
	opts = opts or {}
	local vp = mk("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = opts.size or UDim2.fromScale(1, 1),
		Position = opts.position or UDim2.new(),
		AnchorPoint = opts.anchor or Vector2.zero,
		Ambient = C3(170, 170, 185),
		LightColor = C3(255, 250, 240),
		LightDirection = Vector3.new(-0.6, -1, -0.8),
		ZIndex = opts.z or 3,
	}, parent)
	if not model then
		return vp
	end
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	local cam = mk("Camera", { FieldOfView = 34 }, vp)
	vp.CurrentCamera = cam
	local dist = math.max(size.X, size.Y, size.Z) * (opts.zoom or 1.75)
	local facing = opts.facing or 1 -- 1: model front is +Z (kit props), -1: front is -Z (pets)
	local center = cf.Position
	cam.CFrame = CFrame.lookAt(center + Vector3.new(0, size.Y * 0.18, dist * facing), center)
	if opts.spin ~= false then
		table.insert(spinners, { model = model, base = model:GetPivot(), center = center, phase = math.random() * 6, speed = opts.speed or 0.6 })
	end
	return vp
end

local function kitModel(name, tint)
	local t = props and props:FindFirstChild(name)
	if not t then
		return nil
	end
	local m = t:Clone()
	if tint then
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Material == Enum.Material.Neon then
				d.Color = tint
			end
		end
	end
	return m
end

